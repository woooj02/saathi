# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email: "file" saves each email to data/outbox/; "send" sends it through SMTP.
MAIL_MODE=file
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=contact@keepsrunning.com
# A Zoho app-specific password (Zoho: My Account > Security > App Passwords)
SMTP_PASSWORD=
MAIL_FROM=Saathi <contact@keepsrunning.com>
# Real sends are held back if they come sooner than this after the last one.
MIN_SEND_GAP_SECONDS=300

# The address patient links are built from. Leave empty to use the address the clinic page was opened on.
PUBLIC_BASE_URL=
